APP_NAME="Nexo Tools"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database. The values below target the shared local Docker stack `nexo`
# (MySQL on host port 3307); this repo's compose.yaml only runs the app runtime,
# so the database is reached through host.docker.internal.
# SELF-HOSTING: point these at your own MySQL — see DEPLOYMENT.md.
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3307
DB_DATABASE=nexotools
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# In production (HTTPS) set these to harden the session cookie:
#   SESSION_SECURE_COOKIE=true
#   SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_PORT=8080
VITE_PORT=5173

# Nexo ecosystem (shared chrome: app-switcher + footer). The hub reads the
# registry in config/nexo-ecosystem.php. Leave CURRENT unset for a standalone
# instance with no ecosystem identity.
NEXO_ECOSYSTEM_CURRENT=nexotools
# NEXO_HUB_URL=https://nexotools.alvarocdev.com
# NEXO_GITHUB_ORG=https://github.com/nexo-tools

# Footer attribution ("powered by") — canonical name/shape across every Nexo tool.
# Attribution shown in the footer. Leave unset and the tool shows its own
# neutral default ("made with Nexo Tools"). A third-party instance must NOT advertise
# the upstream author; set your own here.
# NEXO_ATTRIBUTION_LABEL="powered by yoursite.com"
# NEXO_ATTRIBUTION_URL="https://yoursite.com"

# Help center contact (mailto:<email> is used when no support URL is set).
# NEXO_SUPPORT_URL=
# NEXO_SUPPORT_EMAIL=hola@alvarocdev.com

# Who runs this instance, named on /privacidad and /terminos. Unset (default) =
# the "who runs this instance" section is not rendered, so a clone never
# publishes the upstream author's details. Fill both in before going public.
# NEXO_LEGAL_OPERATOR="Tu nombre o razón social"
# NEXO_LEGAL_CONTACT=legal@tudominio.com

# Nexo ID SSO (optional). Off by default: the app runs standalone with local
# accounts. Enable to add "Continuar con Nexo ID" login against a Nexo ID instance
# (OIDC + PKCE). A first SSO sign-up creates the user, then onboarding collects the
# business. Register the client on the provider with an exact redirect of
# {APP_URL}/auth/nexo/callback (php artisan nexo:sso-client).
NEXO_SSO_ENABLED=false
NEXO_SSO_ISSUER=https://nexoid.alvarocdev.com
NEXO_SSO_CLIENT_ID=
# Silent SSO (prompt=none) rides NEXO_SSO_ENABLED; set false to kill-switch it per tool.
NEXO_SSO_SILENT=true
# Where Nexo ID returns the browser after a central (RP-initiated) logout. Register
# this exact URI on the provider or it lands on Nexo ID's own "signed out" page.
NEXO_SSO_POST_LOGOUT_REDIRECT_URI=https://nexotools.alvarocdev.com

# Cookieless ecosystem beacon (opt-in). Off by default: the app runs standalone
# and /beacon answers 204 without writing. Turn on per instance to ingest
# pageviews from the ecosystem tools + alvarocdev. No IP/UA/cookies are stored.
NEXO_BEACON_ENABLED=false
# Where the browser snippet posts. The hub is same-origin (/beacon); a tool on a
# different subdomain points at the hub's absolute URL.
# NEXO_BEACON_ENDPOINT=/beacon
# NEXO_BEACON_RATE_LIMIT=60

# /admin access — CSV of Nexo ID `sub`s allowed into the metrics dashboard.
# Empty (default) = no admin surface (standalone).
NEXO_ADMIN_SUBS=

# Set to Cloudflare ranges or "*" (CF-only origin) in production; empty in dev.
TRUSTED_PROXIES=
